{
  "name": "ecom",
  "version": "1.0.0",
  "description": "ecommerce rest api",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix ./client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "sonarqube": "sonar-scanner",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.frontend.config.js",
    "test:backend": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.backend.config.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:perf:smoke": "STAGE=smoke k6 run __tests__/performance/volume/scripts/smoke.js --out=json=__tests__/performance/volume/results/smoke-results.json",
    "test:perf:baseline": "STAGE=baseline k6 run __tests__/performance/volume/scripts/baseline.js --out=json=__tests__/performance/volume/results/baseline-results.json",
    "test:perf:volume": "STAGE=volume k6 run __tests__/performance/volume/scripts/volume.js --out=json=__tests__/performance/volume/results/volume-results.json",
    "analyze:perf": "node __tests__/performance/volume/analyzeResults.js",
    "test:perf:all": "npm run test:perf:baseline && npm run test:perf:smoke && npm run test:perf:volume && npm run analyze:perf"
  },
  "keywords": [],
  "author": "RP",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@faker-js/faker": "^10.4.0",
    "bcrypt": "^5.1.1",
    "braintree": "^3.22.0",
    "colors": "^1.4.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "date-fns": "^3.3.1",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-formidable": "^1.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "mongoose": "^8.1.2",
    "morgan": "^1.10.0",
    "nodemon": "^3.0.3",
    "react-icons": "^5.0.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.24.1",
    "@playwright/test": "^1.58.2",
    "@types/jest": "^30.0.0",
    "@types/k6": "^1.7.0",
    "@types/node": "^20.12.12",
    "@faker-js/faker": "^10.4.0",
    "babel-jest": "^29.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mongodb-memory-server": "^11.0.1",
    "sonarqube-scanner": "^4.3.5",
    "supertest": "^7.2.2"
  }
}
